{
  "name": "social-ui",
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "lint": "eslint . --ext .vue,.js,.jsx,.cjs,.mjs --fix",
    "lint:check": "eslint . --ext .vue,.js,.jsx,.cjs,.mjs",
    "test:unit": "vitest",
    "test:e2e": "cypress run",
    "test:e2e:dev": "cypress open",
    "docker:build": "docker build -t social-ui .",
    "docker:build:dev": "docker build -f docker/Dockerfile.dev -t social-ui:dev .",
    "docker:run": "docker run -p 8080:80 social-ui",
    "docker:compose": "docker-compose -f docker/docker-compose.yml up -d",
    "docker:compose:dev": "docker-compose -f docker/docker-compose.dev.yml up -d"
  },
  "dependencies": {
    "@popperjs/core": "^2.11.0",
    "@tanstack/vue-virtual": "^3.0.0",
    "@vee-validate/rules": "^4.12.0",
    "axios": "^1.6.0",
    "bootstrap": "^5.3.0",
    "compressorjs": "^1.2.0",
    "crypto-js": "^4.2.0",
    "date-fns": "^2.30.0",
    "emoji-mart": "^5.5.2",
    "file-saver": "^2.0.0",
    "lodash-es": "^4.17.0",
    "pinia": "^2.1.0",
    "socket.io-client": "^4.7.0",
    "uuid": "^9.0.0",
    "vee-validate": "^4.12.0",
    "vue": "^3.4.0",
    "vue-router": "^4.2.0",
    "vue-toastification": "^2.0.0-rc.5",
    "vue3-toastify": "^0.2.3"
  },
  "devDependencies": {
    "@types/lodash-es": "^4.17.0",
    "@types/uuid": "^9.0.0",
    "@vitejs/plugin-vue": "^4.5.0",
    "@vue/test-utils": "^2.4.0",
    "cypress": "^13.0.0",
    "eslint": "^8.49.0",
    "eslint-config-prettier": "^9.0.0",
    "eslint-plugin-prettier": "^5.0.0",
    "eslint-plugin-vue": "^9.17.0",
    "jsdom": "^23.0.0",
    "prettier": "^3.0.0",
    "sass": "^1.69.0",
    "typescript": "^5.0.0",
    "vite": "^5.0.0",
    "vitest": "^1.0.0",
    "vue-tsc": "^1.8.0"
  }
}

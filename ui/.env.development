# ============================================================================
# DEVELOPMENT ENVIRONMENT CONFIGURATION
# ============================================================================

# Application Configuration
NODE_ENV=development
VITE_APP_NAME="Social Connect Dev"
VITE_APP_VERSION="1.0.0-dev"
VITE_APP_DESCRIPTION="Social Media Platform for Developers"

# API Configuration
VITE_API_URL=http://localhost:8080/api/v1
VITE_API_TIMEOUT=30000
VITE_API_RETRY_ATTEMPTS=3
VITE_API_RETRY_DELAY=1000

# WebSocket Configuration
VITE_WS_URL=ws://localhost:8080
VITE_WS_RECONNECT_ATTEMPTS=5
VITE_WS_RECONNECT_DELAY=1000

# Authentication Configuration
VITE_JWT_STORAGE_KEY=social_auth_token
VITE_REFRESH_TOKEN_KEY=social_refresh_token
VITE_SESSION_TIMEOUT=1800000
VITE_REMEMBER_ME_DURATION=2592000000

# File Upload Configuration
VITE_MAX_FILE_SIZE=10485760
VITE_ALLOWED_IMAGE_TYPES=image/jpeg,image/png,image/gif,image/webp
VITE_ALLOWED_VIDEO_TYPES=video/mp4,video/webm,video/quicktime
VITE_ALLOWED_DOCUMENT_TYPES=application/pdf,application/msword,application/vnd.openxmlformats-officedocument.wordprocessingml.document

# Feature Flags
VITE_ENABLE_DARK_MODE=true
VITE_ENABLE_NOTIFICATIONS=true
VITE_ENABLE_PWA=true
VITE_ENABLE_ANALYTICS=false
VITE_ENABLE_ERROR_REPORTING=true
VITE_ENABLE_REAL_TIME_TYPING=true
VITE_ENABLE_MESSAGE_REACTIONS=true
VITE_ENABLE_VOICE_MESSAGES=false
VITE_ENABLE_VIDEO_CALLS=false

# Cache Configuration
VITE_CACHE_ENABLED=true
VITE_CACHE_PREFIX=social_dev_
VITE_CACHE_VERSION=1.0.0
VITE_CACHE_TTL=3600000

# Performance Configuration
VITE_INFINITE_SCROLL_THRESHOLD=100
VITE_MESSAGE_BATCH_SIZE=50
VITE_FEED_PAGE_SIZE=20
VITE_SEARCH_DEBOUNCE_DELAY=300
VITE_TYPING_DEBOUNCE_DELAY=1000

# UI Configuration
VITE_DEFAULT_THEME=light
VITE_THEME_STORAGE_KEY=social_theme
VITE_LANGUAGE=vi
VITE_TIMEZONE=Asia/Ho_Chi_Minh
VITE_DATE_FORMAT=DD/MM/YYYY
VITE_TIME_FORMAT=HH:mm

# Development Tools
VITE_DEBUG_MODE=true
VITE_LOG_LEVEL=debug
VITE_ENABLE_REDUX_DEVTOOLS=true
VITE_ENABLE_VUE_DEVTOOLS=true
VITE_SHOW_PERFORMANCE_METRICS=true

# External Services (Development)
VITE_GOOGLE_CLIENT_ID=your-google-client-id-dev
VITE_FACEBOOK_APP_ID=your-facebook-app-id-dev
VITE_GITHUB_CLIENT_ID=your-github-client-id-dev

# Analytics and Monitoring (Disabled in Development)
VITE_GOOGLE_ANALYTICS_ID=
VITE_SENTRY_DSN=
VITE_HOTJAR_ID=

# CDN Configuration (Local in Development)
VITE_CDN_URL=http://localhost:8080/uploads
VITE_STATIC_URL=http://localhost:3000

# Security Configuration
VITE_ENABLE_CSP=false
VITE_ENABLE_HTTPS_ONLY=false
VITE_CSRF_TOKEN_NAME=csrf_token

# Redis Configuration (for client-side caching keys)
VITE_REDIS_KEY_PREFIX=social_dev_
VITE_USER_CACHE_TTL=3600
VITE_POST_CACHE_TTL=1800
VITE_CONVERSATION_CACHE_TTL=3600

# Message Configuration
VITE_MAX_MESSAGE_LENGTH=4000
VITE_MAX_MESSAGES_PER_REQUEST=50
VITE_MESSAGE_RETRY_ATTEMPTS=3
VITE_MESSAGE_RETRY_DELAY=2000

# Notification Configuration
VITE_NOTIFICATION_PERMISSION_REQUEST=true
VITE_NOTIFICATION_SOUND_ENABLED=true
VITE_NOTIFICATION_DESKTOP_ENABLED=true
VITE_NOTIFICATION_DURATION=5000

# Search Configuration
VITE_SEARCH_MIN_QUERY_LENGTH=2
VITE_SEARCH_MAX_RESULTS=50
VITE_SEARCH_HIGHLIGHT_ENABLED=true

# Media Configuration
VITE_IMAGE_QUALITY=0.8
VITE_IMAGE_MAX_WIDTH=1920
VITE_IMAGE_MAX_HEIGHT=1080
VITE_VIDEO_MAX_DURATION=300
VITE_AVATAR_SIZE=200

# Development Server Configuration
VITE_DEV_SERVER_HOST=0.0.0.0
VITE_DEV_SERVER_PORT=3000
VITE_DEV_SERVER_HTTPS=false

# Build Configuration
VITE_BUILD_SOURCEMAP=true
VITE_BUILD_MINIFY=false
VITE_BUILD_ANALYZE=false

# Testing Configuration
VITE_TEST_USER_EMAIL=test@example.com
VITE_TEST_USER_PASSWORD=password123
VITE_MOCK_API_DELAY=1000
VITE_ENABLE_API_MOCKING=false

# Accessibility Configuration
VITE_ENABLE_A11Y_TESTING=true
VITE_HIGH_CONTRAST_MODE=false
VITE_REDUCE_MOTION=false

# Experimental Features
VITE_ENABLE_SERVICE_WORKER=true
VITE_ENABLE_OFFLINE_MODE=true
VITE_ENABLE_BACKGROUND_SYNC=true
VITE_ENABLE_PUSH_NOTIFICATIONS=false
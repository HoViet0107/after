# ============================================================================
# PRODUCTION ENVIRONMENT CONFIGURATION
# ============================================================================

# Application Configuration
NODE_ENV=production
VITE_APP_NAME="Social Connect"
VITE_APP_VERSION="1.0.0"
VITE_APP_DESCRIPTION="Connect, Share, and Communicate"

# API Configuration
VITE_API_URL=https://api.socialconnect.com/api/v1
VITE_API_TIMEOUT=30000
VITE_API_RETRY_ATTEMPTS=3
VITE_API_RETRY_DELAY=2000

# WebSocket Configuration
VITE_WS_URL=wss://api.socialconnect.com
VITE_WS_RECONNECT_ATTEMPTS=10
VITE_WS_RECONNECT_DELAY=5000

# Authentication Configuration
VITE_JWT_STORAGE_KEY=social_auth_token
VITE_REFRESH_TOKEN_KEY=social_refresh_token
VITE_SESSION_TIMEOUT=1800000
VITE_REMEMBER_ME_DURATION=2592000000

# File Upload Configuration
VITE_MAX_FILE_SIZE=10485760
VITE_ALLOWED_IMAGE_TYPES=image/jpeg,image/png,image/gif,image/webp
VITE_ALLOWED_VIDEO_TYPES=video/mp4,video/webm
VITE_ALLOWED_DOCUMENT_TYPES=application/pdf,application/msword,application/vnd.openxmlformats-officedocument.wordprocessingml.document

# Feature Flags
VITE_ENABLE_DARK_MODE=true
VITE_ENABLE_NOTIFICATIONS=true
VITE_ENABLE_PWA=true
VITE_ENABLE_ANALYTICS=true
VITE_ENABLE_ERROR_REPORTING=true
VITE_ENABLE_REAL_TIME_TYPING=true
VITE_ENABLE_MESSAGE_REACTIONS=true
VITE_ENABLE_VOICE_MESSAGES=true
VITE_ENABLE_VIDEO_CALLS=true

# Cache Configuration
VITE_CACHE_ENABLED=true
VITE_CACHE_PREFIX=social_
VITE_CACHE_VERSION=1.0.0
VITE_CACHE_TTL=7200000

# Performance Configuration
VITE_INFINITE_SCROLL_THRESHOLD=100
VITE_MESSAGE_BATCH_SIZE=50
VITE_FEED_PAGE_SIZE=20
VITE_SEARCH_DEBOUNCE_DELAY=300
VITE_TYPING_DEBOUNCE_DELAY=1000

# UI Configuration
VITE_DEFAULT_THEME=light
VITE_THEME_STORAGE_KEY=social_theme
VITE_LANGUAGE=vi
VITE_TIMEZONE=Asia/Ho_Chi_Minh
VITE_DATE_FORMAT=DD/MM/YYYY
VITE_TIME_FORMAT=HH:mm

# Development Tools (Disabled in Production)
VITE_DEBUG_MODE=false
VITE_LOG_LEVEL=error
VITE_ENABLE_REDUX_DEVTOOLS=false
VITE_ENABLE_VUE_DEVTOOLS=false
VITE_SHOW_PERFORMANCE_METRICS=false

# External Services (Production)
VITE_GOOGLE_CLIENT_ID=your-google-client-id-prod
VITE_FACEBOOK_APP_ID=your-facebook-app-id-prod
VITE_GITHUB_CLIENT_ID=your-github-client-id-prod

# Analytics and Monitoring
VITE_GOOGLE_ANALYTICS_ID=GA-XXXXXXXXX-X
VITE_SENTRY_DSN=https://xxxxx@sentry.io/xxxxx
VITE_HOTJAR_ID=xxxxxxx

# CDN Configuration
VITE_CDN_URL=https://cdn.socialconnect.com
VITE_STATIC_URL=https://static.socialconnect.com

# Security Configuration
VITE_ENABLE_CSP=true
VITE_ENABLE_HTTPS_ONLY=true
VITE_CSRF_TOKEN_NAME=csrf_token

# Redis Configuration (for client-side caching keys)
VITE_REDIS_KEY_PREFIX=social_
VITE_USER_CACHE_TTL=7200
VITE_POST_CACHE_TTL=3600
VITE_CONVERSATION_CACHE_TTL=7200

# Message Configuration
VITE_MAX_MESSAGE_LENGTH=4000
VITE_MAX_MESSAGES_PER_REQUEST=50
VITE_MESSAGE_RETRY_ATTEMPTS=5
VITE_MESSAGE_RETRY_DELAY=3000

# Notification Configuration
VITE_NOTIFICATION_PERMISSION_REQUEST=true
VITE_NOTIFICATION_SOUND_ENABLED=true
VITE_NOTIFICATION_DESKTOP_ENABLED=true
VITE_NOTIFICATION_DURATION=5000

# Search Configuration
VITE_SEARCH_MIN_QUERY_LENGTH=2
VITE_SEARCH_MAX_RESULTS=50
VITE_SEARCH_HIGHLIGHT_ENABLED=true

# Media Configuration
VITE_IMAGE_QUALITY=0.85
VITE_IMAGE_MAX_WIDTH=1920
VITE_IMAGE_MAX_HEIGHT=1080
VITE_VIDEO_MAX_DURATION=300
VITE_AVATAR_SIZE=200

# Build Configuration
VITE_BUILD_SOURCEMAP=false
VITE_BUILD_MINIFY=true
VITE_BUILD_ANALYZE=false

# Performance Monitoring
VITE_PERFORMANCE_BUDGET_JS=250
VITE_PERFORMANCE_BUDGET_CSS=50
VITE_PERFORMANCE_BUDGET_IMAGES=500
VITE_ENABLE_BUNDLE_ANALYZER=false

# SEO Configuration
VITE_SITE_URL=https://socialconnect.com
VITE_SITE_TITLE="Social Connect - Connect with Friends"
VITE_SITE_DESCRIPTION="The best social media platform to connect, share, and communicate with friends and family."
VITE_SITE_KEYWORDS="social media, chat, messaging, friends, connect, share"
VITE_SITE_AUTHOR="Social Connect Team"

# Social Media Meta Tags
VITE_OG_TITLE="Social Connect"
VITE_OG_DESCRIPTION="Connect, Share, and Communicate with ease"
VITE_OG_IMAGE="https://cdn.socialconnect.com/og-image.jpg"
VITE_OG_URL="https://socialconnect.com"
VITE_TWITTER_CARD="summary_large_image"
VITE_TWITTER_SITE="@socialconnect"

# PWA Configuration
VITE_PWA_NAME="Social Connect"
VITE_PWA_SHORT_NAME="SocialConnect"
VITE_PWA_DESCRIPTION="Social Media Platform"
VITE_PWA_THEME_COLOR="#667eea"
VITE_PWA_BACKGROUND_COLOR="#ffffff"
VITE_PWA_DISPLAY="standalone"
VITE_PWA_ORIENTATION="portrait"

# Content Security Policy
VITE_CSP_DEFAULT_SRC="'self'"
VITE_CSP_SCRIPT_SRC="'self' 'unsafe-inline' https://www.google-analytics.com"
VITE_CSP_STYLE_SRC="'self' 'unsafe-inline' https://fonts.googleapis.com"
VITE_CSP_FONT_SRC="'self' https://fonts.gstatic.com"
VITE_CSP_IMG_SRC="'self' data: blob: https:"
VITE_CSP_CONNECT_SRC="'self' wss: https:"

# Rate Limiting (Client-side)
VITE_CLIENT_RATE_LIMIT_REQUESTS=100
VITE_CLIENT_RATE_LIMIT_WINDOW=60000
VITE_CLIENT_RATE_LIMIT_MESSAGE_REQUESTS=50
VITE_CLIENT_RATE_LIMIT_MESSAGE_WINDOW=60000

# Backup and Recovery
VITE_ENABLE_LOCAL_BACKUP=true
VITE_BACKUP_INTERVAL=3600000
VITE_MAX_BACKUP_SIZE=50485760

# Accessibility Configuration
VITE_ENABLE_A11Y_TESTING=false
VITE_HIGH_CONTRAST_MODE=false
VITE_REDUCE_MOTION=false

# Experimental Features (Disabled in Production)
VITE_ENABLE_SERVICE_WORKER=true
VITE_ENABLE_OFFLINE_MODE=true
VITE_ENABLE_BACKGROUND_SYNC=true
VITE_ENABLE_PUSH_NOTIFICATIONS=true

# Legal and Compliance
VITE_PRIVACY_POLICY_URL="https://socialconnect.com/privacy"
VITE_TERMS_OF_SERVICE_URL="https://socialconnect.com/terms"
VITE_COOKIE_POLICY_URL="https://socialconnect.com/cookies"
VITE_GDPR_COMPLIANCE=true
VITE_CCPA_COMPLIANCE=true

# Support and Contact
VITE_SUPPORT_EMAIL="support@socialconnect.com"
VITE_SUPPORT_PHONE="+1-555-0123"
VITE_SUPPORT_URL="https://support.socialconnect.com"
VITE_CONTACT_URL="https://socialconnect.com/contact"

# Version and Release Information
VITE_BUILD_DATE=2024-01-01T00:00:00Z
VITE_GIT_COMMIT_SHA=abcdef123456
VITE_RELEASE_NOTES_URL="https://socialconnect.com/releases"